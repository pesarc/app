{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@pesarc/sdk/*": ["./src/*"],
      "@pesarc/abi": ["../abi/src/index.ts"],
      "@pesarc/abi/*": ["../abi/src/*"]
    }
  },
  "include": ["src"]
}
