
NEXT_PUBLIC_CELO_AGENT_SESSION_KEYS=
NEXT_PUBLIC_CELO_AGENT_KEY=

# Admin gate — when set, /api/admin/catalog requires the x-admin-secret header
# to match this value (the /admin page prompts for it and stores it locally).
# Leave unset for an open demo. Generate one with: openssl rand -hex 16
ADMIN_SECRET=

# LLM (OpenRouter) — when unset, the settlement agent replies in demo mode
# (understands the request but doesn't submit on-chain).
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=

# Settlement agent signing key — required for the agent to act on-chain.
CELO_AGENT_PK=

# Persistence — Neon Postgres when set, else a local .data/*.jsonl file fallback.
DATABASE_URL=

# On-chain prediction markets (Arb Sepolia). When these + an owner key are set,
# proposing a binary market creates it on-chain (owner-signed). The PredictionMarket
# must be owned by the key below. Multi-outcome markets stay store-backed.
NEXT_PUBLIC_ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_ARB_SEPOLIA_PREDICTION_MARKET=
NEXT_PUBLIC_ARB_TOKEN_NGN=
NEXT_PUBLIC_ARB_TOKEN_GHS=
NEXT_PUBLIC_ARB_TOKEN_KES=
# Owner of the PredictionMarket, used server-side to sign createMarket.
# Falls back to SETTLE_OPERATOR_PK when unset.
MARKET_OWNER_PK=
SETTLE_OPERATOR_PK=

# Multi-chain prediction market. Active EVM chain per session (the smart wallet
# is chain-scoped); Solana venue is always shown when its program is set.
NEXT_PUBLIC_ACTIVE_CHAIN=arbitrum-sepolia
NEXT_PUBLIC_BASE_SEPOLIA_PREDICTION_MARKET=
NEXT_PUBLIC_BASE_SEPOLIA_TOKEN_NGN=
NEXT_PUBLIC_BASE_SEPOLIA_TOKEN_GHS=
NEXT_PUBLIC_BASE_SEPOLIA_TOKEN_KES=
NEXT_PUBLIC_SVM_PREDICTION_MARKET=
# Faucet (/api/faucet) mints test stablecoins via SETTLE_OPERATOR_PK on Arb Sepolia.

# Fiat off-ramp (bank / mobile-money payouts). Unset = simulated sandbox.
#
# The off-ramp is MULTI-PROVIDER: configure any of the adapters below and the
# router picks, per payout, the first configured provider that supports it
# (currency/method), with the simulator as the universal fallback. Priority is
# RAMP_PROVIDER_ORDER (default: paystack,flutterwave,http). The provider that
# handled a payout is stored on the row so status/webhook resolve back to it.
RAMP_PROVIDER_ORDER=
#
# Provider A — Paystack (Nigeria bank transfers). Creates a transfer recipient +
# transfer; Paystack POSTs status to /api/payouts/webhook (HMAC-SHA512 with this
# key, header x-paystack-signature). Needs a funded NGN balance + transfers OTP
# disabled.
PAYSTACK_SECRET_KEY=
#
# Provider B — Flutterwave (pan-African bank + mobile money, NGN/GHS/KES/…).
# POSTs /v3/transfers; webhook verified by the static `verif-hash` header ==
# FLUTTERWAVE_WEBHOOK_HASH (the "Secret hash" from the Flutterwave dashboard).
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
#
# RAMP_PROVIDER=http forces the generic adapter (Provider C) even when a
# provider key above is present.
RAMP_PROVIDER=
#
# Option B — a generic licensed provider (e.g. a crypto off-ramp like Yellow
# Card / Fincra). The app POSTs the payout to RAMP_PROVIDER_URL/payouts; the
# partner POSTs status to /api/payouts/webhook, verified with RAMP_WEBHOOK_SECRET
# (HMAC-SHA256, header x-ramp-signature).
RAMP_PROVIDER_URL=
RAMP_API_KEY=
RAMP_WEBHOOK_SECRET=

# Per-chain Alchemy Gas Manager policies (optional). If a chain isn't listed,
# the default NEXT_PUBLIC_ALCHEMY_GAS_POLICY_ID is used (which can itself cover
# multiple networks when configured that way in the Alchemy dashboard).
NEXT_PUBLIC_ALCHEMY_GAS_POLICY_ID_ARB_SEPOLIA=
NEXT_PUBLIC_ALCHEMY_GAS_POLICY_ID_BASE_SEPOLIA=

# Circle Arc testnet (chain 5042002, USDC is the gas token). Deploy with
# contracts/evm/script/DeployArc.s.sol; the app then shows Arc in the selector.
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_TESTNET_PREDICTION_MARKET=
NEXT_PUBLIC_ARC_TESTNET_REALIZED_ORACLE=
NEXT_PUBLIC_ARC_TESTNET_INTENT_MATCHER=
NEXT_PUBLIC_ARC_TESTNET_TOKEN_NGN=
NEXT_PUBLIC_ARC_TESTNET_TOKEN_GHS=
NEXT_PUBLIC_ARC_TESTNET_TOKEN_KES=
# USDC is a native predeploy on Arc (same address on testnet + mainnet).
NEXT_PUBLIC_ARC_TESTNET_TOKEN_USD=0x3600000000000000000000000000000000000000

# Circle Arc MAINNET (chain 5042, USDC is the gas token) — REQUIRED for the
# Circle/Arc microgrant (testnet does not qualify). Deploy with DeployArc.s.sol
# against --rpc-url arc (ENV_PREFIX defaults to ARC); fund the deployer with USDC
# on Arc mainnet for gas, then fill these.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_PREDICTION_MARKET=
NEXT_PUBLIC_ARC_REALIZED_ORACLE=
NEXT_PUBLIC_ARC_INTENT_MATCHER=
NEXT_PUBLIC_ARC_TOKEN_NGN=
NEXT_PUBLIC_ARC_TOKEN_GHS=
NEXT_PUBLIC_ARC_TOKEN_KES=
NEXT_PUBLIC_ARC_TOKEN_USD=0x3600000000000000000000000000000000000000
