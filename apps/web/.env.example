# Pesarc — environment template. Copy to .env and fill in.
# .env is git-ignored; never commit real secrets.

# Neon Postgres (waitlist + transfers). Empty = local .data/*.jsonl fallback.
DATABASE_URL=""

# Public site URL (SEO / canonical / sitemap)
NEXT_PUBLIC_SITE_URL="https://pesarc.app"

# ----- Testnet beta (B1/B2/B3) -----
# Privy app ID. Empty = mock mode (simulated demo). Set it to enable live
# testnet mode: passkey/phone sign-up + smart wallet on the hub chain.
NEXT_PUBLIC_PRIVY_APP_ID=""
# Alchemy Wallet APIs key + Gas Manager policy for gasless smart-wallet sends.
NEXT_PUBLIC_ALCHEMY_API_KEY=""
NEXT_PUBLIC_ALCHEMY_GAS_POLICY_ID=""
# Destination for testnet sends; empty = self-send.
NEXT_PUBLIC_TEST_RECIPIENT=""

# Hub chain: 421614 = Arbitrum Sepolia | 11155111 = Ethereum Sepolia (current deployment).
NEXT_PUBLIC_HUB_CHAIN_ID="11155111"
NEXT_PUBLIC_HUB_RPC_URL=""

# Arbitrum Sepolia contract addresses (after redeploying the hub there).
NEXT_PUBLIC_ARB_POOL_MANAGER=""
NEXT_PUBLIC_ARB_HOOK=""
NEXT_PUBLIC_ARB_SWAP_ROUTER=""
NEXT_PUBLIC_ARB_LIQUIDITY_ROUTER=""
NEXT_PUBLIC_ARB_SAFETY_MODULE=""
NEXT_PUBLIC_ARB_ORACLE_ADAPTER=""
NEXT_PUBLIC_ARB_STATE_VIEW=""
NEXT_PUBLIC_ARB_TOKEN_USD=""
NEXT_PUBLIC_ARB_TOKEN_NGN=""

NEXT_PUBLIC_ARB_QUOTER=
NEXT_PUBLIC_ARB_FX_AGGREGATOR=
NEXT_PUBLIC_ARB_SETTLEMENT_NETTING=
NEXT_PUBLIC_ARB_TOKEN_GHS=
NEXT_PUBLIC_ARB_INTENT_MATCHER=

# Server-only: netting-set operator key (testnet KYB auto-approve + settle CRON stand-in)
SETTLE_OPERATOR_PK=
NEXT_PUBLIC_ARB_BRIDGE_RECEIVER=
NEXT_PUBLIC_ARB_REALIZED_ORACLE=
NEXT_PUBLIC_ARB_TOKEN_KES=

# Auth for privileged API routes (settle/join/oracle/solver). Production MUST set this.
OPERATOR_API_SECRET=
# Vercel Cron secret — guards the scheduled solver run.
CRON_SECRET=

# Server-only: verifies Privy access tokens so DB rows scope to the real user.
# Without it every caller falls back to the shared demo account.
PRIVY_APP_SECRET=

# --- Celo "Agents at Work" submission ---
# Model-agnostic LLM for the settlement agent (OpenAI-compatible or Anthropic).
# Cencori (hackathon AI partner) is OpenAI-compatible — set its base URL here.
LLM_PROVIDER=            # openai | anthropic (default: auto-detect)
LLM_BASE_URL=            # e.g. https://api.cencori.com/v1  (OpenAI-compatible)
LLM_API_KEY=
LLM_MODEL=               # e.g. gpt-4o-mini, llama-3.3-70b, claude-sonnet-4-5
# Server-only: the settlement agent's key on Celo (submits intents + settles).
CELO_AGENT_PK=
NEXT_PUBLIC_CELO_RPC_URL=
NEXT_PUBLIC_CELO_INTENT_MATCHER=
NEXT_PUBLIC_CELO_REALIZED_ORACLE=
NEXT_PUBLIC_CELO_TOKEN_NGN=
NEXT_PUBLIC_CELO_TOKEN_GHS=
NEXT_PUBLIC_CELO_TOKEN_KES=
# ERC-8021 attribution tag from Celo Builders registration (celo_...). Required
# to be counted on the hackathon leaderboards — it goes in every tx's calldata.
NEXT_PUBLIC_CELO_ATTRIBUTION_TAG=
NEXT_PUBLIC_CELO_OWN_TAG=

# --- Pesarc on Celo Sepolia (prediction & hedge market) ---
NEXT_PUBLIC_CELO_RPC_URL=
NEXT_PUBLIC_CELO_INTENT_MATCHER=
NEXT_PUBLIC_CELO_REALIZED_ORACLE=
NEXT_PUBLIC_CELO_PREDICTION_MARKET=
NEXT_PUBLIC_CELO_TOKEN_NGN=
NEXT_PUBLIC_CELO_TOKEN_GHS=
NEXT_PUBLIC_CELO_TOKEN_KES=
NEXT_PUBLIC_CELO_TOKEN_USD=

# --- Agent session keys (bounded on-chain agent authority) ---
# Deployed testnet addresses (public). The app reads a live agent spend budget
# from these; the agent key is also the demo grantee.
NEXT_PUBLIC_CELO_AGENT_SESSION_KEYS="0xe0412006528b0ff3Ee211ac9dB6dd5c137c9201F"  # Celo Sepolia
NEXT_PUBLIC_CELO_AGENT_KEY="0x8bC6b190150796d92E7c32974338fB2F94033ed5"
NEXT_PUBLIC_ARB_AGENT_SESSION_KEYS="0xA3695D1f817632643B0568F7Fd08b3C31d6B5aab"  # Arbitrum Sepolia

# --- Multi-EVM: deploy the market/P2P suite on any chain ---
# Pick the active venue the app reads (see packages/sdk/src/chain/registry.ts).
# Keys: celo-sepolia | celo | base-sepolia | base | arbitrum-sepolia | arbitrum
#       | optimism | optimism-sepolia | polygon | sepolia | ethereum
NEXT_PUBLIC_ACTIVE_CHAIN=celo-sepolia
# Add a chain by setting its prefixed addresses, e.g. for Base:
#   NEXT_PUBLIC_BASE_PREDICTION_MARKET, _REALIZED_ORACLE, _INTENT_MATCHER,
#   _AGENT_SESSION_KEYS, _AGENT_KEY, _TOKEN_{NGN,KES,GHS,USD}, _RPC_URL

# --- Solana venue (prediction markets + P2P on SVM) ---
# Set NEXT_PUBLIC_ACTIVE_CHAIN=solana (or solana-devnet) to make Solana the
# active home. Program id defaults to the Anchor workspace's declared id.
# NEXT_PUBLIC_SVM_CLUSTER=devnet          # devnet | testnet | mainnet-beta
# NEXT_PUBLIC_SVM_RPC_URL=                # custom RPC (else the cluster default)
# NEXT_PUBLIC_SVM_PREDICTION_MARKET=      # prediction_market program id
# NEXT_PUBLIC_SVM_REALIZED_ORACLE=        # realized_rate_oracle program id
# NEXT_PUBLIC_SVM_COLLATERAL_DECIMALS=6   # SPL mint decimals
# Gasless: a fee-payer relayer co-signs + submits SVM txs so users pay 0 SOL.
# NEXT_PUBLIC_SVM_FEE_PAYER=              # relayer public key (empty = user pays)
# SVM_FEE_PAYER_SECRET=                   # server-only: relayer secret (JSON array)

# --- LLM via OpenRouter (OpenAI-compatible) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=openai/gpt-4o-mini    # any OpenRouter model id
# OPENROUTER_APP_NAME=Pesarc

# --- Invest broker / market-data (stocks & ETFs) ---
# Empty = simulated broker (catalog prices, paper positions), fully demoable.
# Set to route quotes + orders to a real tokenized-equity / broker provider
# (see packages/sdk/src/broker.ts). No real order is placed until set.
NEXT_PUBLIC_BROKER_API_URL=
NEXT_PUBLIC_BROKER_API_KEY=

# --- Fiat off-ramp partner (fiat last mile for bank / mobile-money payouts) ---
# Empty = simulated settlement (initiated → processing → paid on a timeline),
# fully demoable on testnet. Set these to drive payout status from a real
# provider's API (see packages/sdk/src/ramp.ts). No real funds move on testnet.
RAMP_PROVIDER_URL=
RAMP_API_KEY=
