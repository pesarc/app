# Pesarc — environment template. Copy to .env and fill in.
# .env is git-ignored; never commit real secrets.

# Which environment this is: development | staging | production.
# Drives the off-prod ribbon and env-aware behavior. NEXT_PUBLIC_APP_ENV is the
# one the browser sees (must be set at build time for staging/dev); APP_ENV is
# the server value. Unset resolves to development locally, production in a
# production build. Keep these DIFFERENT per environment (see deploy/ENVIRONMENTS.md).
APP_ENV="development"
NEXT_PUBLIC_APP_ENV="development"

# Postgres for THIS environment. Each of dev/staging/prod points at its OWN
# database instance (never share prod data with staging/dev). Empty = local
# .data/*.jsonl fallback for quick local dev.
DATABASE_URL=""

# Optional: real bills provider (Reloadly / VTpass / Flutterwave Bills) for
# airtime/data/utility bill pay. Empty = simulated sandbox. Use a sandbox key
# while testing; a real key only in prod.
BILLS_PROVIDER_URL=""
BILLS_PROVIDER_KEY=""

# WhatsApp Cloud API (Meta). Empty = "sandbox" bridge: incoming messages are
# still understood + answered, but replies are logged instead of sent. Fill
# these once a WhatsApp Business number is connected. Webhook URL is
# <origin>/api/whatsapp with WHATSAPP_VERIFY_TOKEN as the verify token, and
# WHATSAPP_APP_SECRET enables X-Hub-Signature-256 verification (required in prod).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_GRAPH_VERSION="v21.0"

# Voice-note transcription (WhatsApp voice + future channels). Empty = voice
# notes are declined with a "please type" reply. OpenAI-compatible endpoint.
TRANSCRIBE_API_KEY=""
TRANSCRIBE_URL="https://api.openai.com/v1/audio/transcriptions"
TRANSCRIBE_MODEL="whisper-1"

# USSD needs no key to receive: point your Africa's Talking (or telco) shortcode
# callback at <origin>/api/ussd. Buys route through BILLS_PROVIDER_URL above.

# Algorand gasless (fee pooling, in-house). The sponsor account pays the group's
# fee so the user's txns cost 0. Empty = disabled. Never NEXT_PUBLIC (server only).
ALGO_SPONSOR_MNEMONIC=""
ALGO_SPONSOR_MAX_FEE="100000"       # microAlgos the sponsor will cover per group
ALGO_SPONSOR_ALLOWED_APPS=""        # comma app ids to cover (empty = any)
ALGOD_TOKEN=""
NEXT_PUBLIC_ALGOD_URL=""            # e.g. https://testnet-api.algonode.cloud
NEXT_PUBLIC_ALGO_NETWORK="testnet"

# Public site URL (SEO / canonical / sitemap)
NEXT_PUBLIC_SITE_URL="https://pesarc.app"

# ----- Testnet beta (B1/B2/B3) -----
# Privy app ID. Empty = mock mode (simulated demo). Set it to enable live
# testnet mode: passkey/phone sign-up + smart wallet on the hub chain.
NEXT_PUBLIC_PRIVY_APP_ID=""
# Gas sponsorship (gasless). Testnets use Alchemy Gas Manager (below). Arc uses
# an ERC-7677 paymaster service (Circle Gas Station or our in-house paymaster) —
# the provider is a swappable seam (sdk/wallet/gasSponsor.ts). See docs/GAS_SPONSORSHIP.md.
NEXT_PUBLIC_ALCHEMY_API_KEY=""
NEXT_PUBLIC_ALCHEMY_GAS_POLICY_ID=""

# Arc gasless: pick the provider (circle | pimlico | inhouse), blank = auto-detect.
NEXT_PUBLIC_GAS_SPONSOR_ARC=""
# Pimlico (recommended Arc bundler): one key builds the bundler URL per chain.
# Add a sponsorship policy id (from the Pimlico dashboard, funded) to also use
# Pimlico as the paymaster (gasless). The bundler alone doesn't sponsor.
NEXT_PUBLIC_PIMLICO_API_KEY=""
NEXT_PUBLIC_PIMLICO_SPONSORSHIP_POLICY_ID=""
# Or set an explicit bundler URL (overrides the Pimlico-built one).
NEXT_PUBLIC_ARC_BUNDLER_URL=""
# Circle Gas Station (fast path, recommended for the Arc grant):
NEXT_PUBLIC_CIRCLE_PAYMASTER_URL=""
# In-house paymaster (survivable path; AUDIT before mainnet):
NEXT_PUBLIC_INHOUSE_PAYMASTER_ADDRESS=""
NEXT_PUBLIC_INHOUSE_PAYMASTER_URL=""
INHOUSE_PAYMASTER_PK=""
INHOUSE_PAYMASTER_MAX_FEE_WEI="50000000000"
# Destination for testnet sends; empty = self-send.
NEXT_PUBLIC_TEST_RECIPIENT=""

# Hub chain: 421614 = Arbitrum Sepolia | 11155111 = Ethereum Sepolia | 5042 = Arc mainnet.
# Flip to 5042 to run on Arc mainnet once the hub is deployed there (fill the
# NEXT_PUBLIC_ARC_HUB_* block below from DeployArc.s.sol). See docs/ARC_SUBMISSION.md.
NEXT_PUBLIC_HUB_CHAIN_ID="11155111"
NEXT_PUBLIC_HUB_RPC_URL=""

# --- Network posture --------------------------------------------------------
# The app DEFAULTS to a testnet chain ("for now let's test on testnet"); mainnet
# chains stay selectable in the in-app switcher. To pin a specific default chain
# (e.g. a mainnet demo) set NEXT_PUBLIC_ACTIVE_CHAIN to its key (arc-testnet,
# arb-sepolia, base-sepolia, arc, base, arbitrum, ...). To flip the whole default
# posture to mainnet, set NEXT_PUBLIC_PREFER_MAINNET=1.
NEXT_PUBLIC_ACTIVE_CHAIN=""
NEXT_PUBLIC_PREFER_MAINNET=""

# Testnet settlement stack — a chain only becomes selectable (and can be the
# testnet default) once its PREDICTION_MARKET is set. Deploy with
# `deploy-evm-chain.sh` to a testnet (or the Arc testnet script) and paste the
# printed NEXT_PUBLIC_<PREFIX>_* lines here. Prefixes: ARC_TESTNET, ARB_SEPOLIA,
# BASE_SEPOLIA, OP_SEPOLIA, ETH_SEPOLIA, CELO_SEPOLIA.
NEXT_PUBLIC_ARC_TESTNET_PREDICTION_MARKET=""
NEXT_PUBLIC_ARC_TESTNET_REALIZED_ORACLE=""
NEXT_PUBLIC_ARC_TESTNET_INTENT_MATCHER=""
NEXT_PUBLIC_ARC_TESTNET_TOKEN_NGN=""
NEXT_PUBLIC_ARC_TESTNET_TOKEN_GHS=""
NEXT_PUBLIC_ARC_TESTNET_TOKEN_KES=""
NEXT_PUBLIC_ARC_TESTNET_TOKEN_USD=""
NEXT_PUBLIC_ARB_SEPOLIA_PREDICTION_MARKET=""
NEXT_PUBLIC_ARB_SEPOLIA_REALIZED_ORACLE=""
NEXT_PUBLIC_ARB_SEPOLIA_INTENT_MATCHER=""

# Arc mainnet (chain 5042) — RPC + explorer (defaults shown; override if wrong).
NEXT_PUBLIC_ARC_RPC_URL="https://rpc.mainnet.arc.io"
NEXT_PUBLIC_ARC_EXPLORER_URL="https://explorer.arc.io"

# Arc mainnet hub contracts — from the DeployArc.s.sol deployment. tokenUsd
# defaults to Arc's native USDC predeploy (0x3600…0000) when left blank.
NEXT_PUBLIC_ARC_HUB_POOL_MANAGER=""
NEXT_PUBLIC_ARC_HUB_HOOK=""
NEXT_PUBLIC_ARC_HUB_SWAP_ROUTER=""
NEXT_PUBLIC_ARC_HUB_LIQUIDITY_ROUTER=""
NEXT_PUBLIC_ARC_HUB_SAFETY_MODULE=""
NEXT_PUBLIC_ARC_HUB_ORACLE_ADAPTER=""
NEXT_PUBLIC_ARC_HUB_STATE_VIEW=""
NEXT_PUBLIC_ARC_HUB_TOKEN_USD=""
NEXT_PUBLIC_ARC_HUB_TOKEN_NGN=""
NEXT_PUBLIC_ARC_HUB_QUOTER=""
NEXT_PUBLIC_ARC_HUB_SETTLEMENT_NETTING=""
NEXT_PUBLIC_ARC_HUB_INTENT_MATCHER=""
NEXT_PUBLIC_ARC_HUB_REALIZED_ORACLE=""
NEXT_PUBLIC_ARC_HUB_TOKEN_GHS=""
NEXT_PUBLIC_ARC_HUB_TOKEN_KES=""
NEXT_PUBLIC_ARC_HUB_POOL_FEE=""
NEXT_PUBLIC_ARC_HUB_TICK_SPACING=""
NEXT_PUBLIC_ARC_HUB_DEPLOY_BLOCK=""
NEXT_PUBLIC_ARC_HUB_MATCHER_BLOCK=""
NEXT_PUBLIC_ARC_HUB_BRIDGE_BLOCK=""

# Arbitrum Sepolia contract addresses (after redeploying the hub there).
NEXT_PUBLIC_ARB_POOL_MANAGER=""
NEXT_PUBLIC_ARB_HOOK=""
NEXT_PUBLIC_ARB_SWAP_ROUTER=""
NEXT_PUBLIC_ARB_LIQUIDITY_ROUTER=""
NEXT_PUBLIC_ARB_SAFETY_MODULE=""
NEXT_PUBLIC_ARB_ORACLE_ADAPTER=""
NEXT_PUBLIC_ARB_STATE_VIEW=""
NEXT_PUBLIC_ARB_TOKEN_USD=""
NEXT_PUBLIC_ARB_TOKEN_NGN=""

NEXT_PUBLIC_ARB_QUOTER=
NEXT_PUBLIC_ARB_FX_AGGREGATOR=
NEXT_PUBLIC_ARB_SETTLEMENT_NETTING=
NEXT_PUBLIC_ARB_TOKEN_GHS=
NEXT_PUBLIC_ARB_INTENT_MATCHER=

# Server-only: netting-set operator key (testnet KYB auto-approve + settle CRON stand-in).
# Also the agent's on-chain signer on the ACTIVE chain (web2 -> web3): the agent
# brain (chat / WhatsApp / USSD / API) submits + settles intents from this key on
# whichever chain is active. Per-chain override: <PREFIX>_AGENT_PK (e.g. ARC_AGENT_PK,
# CELO_AGENT_PK); falls back to SETTLE_OPERATOR_PK then AGENT_PK. Must be the chain's
# IntentMatcher solver (setSolver) — on Arc that's the deployer/operator.
SETTLE_OPERATOR_PK=
ARC_AGENT_PK=
NEXT_PUBLIC_ARB_BRIDGE_RECEIVER=
NEXT_PUBLIC_ARB_REALIZED_ORACLE=
NEXT_PUBLIC_ARB_TOKEN_KES=

# Auth for privileged API routes (settle/join/oracle/solver). Production MUST set this.
OPERATOR_API_SECRET=
# Vercel Cron secret — guards the scheduled solver run.
CRON_SECRET=

# Server-only: verifies Privy access tokens so DB rows scope to the real user.
# Without it every caller falls back to the shared demo account.
PRIVY_APP_SECRET=

# --- Celo "Agents at Work" submission ---
# Model-agnostic LLM for the settlement agent (OpenAI-compatible or Anthropic).
# Cencori (hackathon AI partner) is OpenAI-compatible — set its base URL here.
LLM_PROVIDER=            # openai | anthropic (default: auto-detect)
LLM_BASE_URL=            # e.g. https://api.cencori.com/v1  (OpenAI-compatible)
LLM_API_KEY=
LLM_MODEL=               # e.g. gpt-4o-mini, llama-3.3-70b, claude-sonnet-4-5
# Server-only: the settlement agent's key on Celo (submits intents + settles).
CELO_AGENT_PK=
NEXT_PUBLIC_CELO_RPC_URL=
NEXT_PUBLIC_CELO_INTENT_MATCHER=
NEXT_PUBLIC_CELO_REALIZED_ORACLE=
NEXT_PUBLIC_CELO_TOKEN_NGN=
NEXT_PUBLIC_CELO_TOKEN_GHS=
NEXT_PUBLIC_CELO_TOKEN_KES=
# ERC-8021 attribution tag from Celo Builders registration (celo_...). Required
# to be counted on the hackathon leaderboards — it goes in every tx's calldata.
NEXT_PUBLIC_CELO_ATTRIBUTION_TAG=
NEXT_PUBLIC_CELO_OWN_TAG=

# --- Pesarc on Celo Sepolia (prediction & hedge market) ---
NEXT_PUBLIC_CELO_RPC_URL=
NEXT_PUBLIC_CELO_INTENT_MATCHER=
NEXT_PUBLIC_CELO_REALIZED_ORACLE=
NEXT_PUBLIC_CELO_PREDICTION_MARKET=
NEXT_PUBLIC_CELO_TOKEN_NGN=
NEXT_PUBLIC_CELO_TOKEN_GHS=
NEXT_PUBLIC_CELO_TOKEN_KES=
NEXT_PUBLIC_CELO_TOKEN_USD=

# --- Agent session keys (bounded on-chain agent authority) ---
# Deployed testnet addresses (public). The app reads a live agent spend budget
# from these; the agent key is also the demo grantee.
NEXT_PUBLIC_CELO_AGENT_SESSION_KEYS="0xe0412006528b0ff3Ee211ac9dB6dd5c137c9201F"  # Celo Sepolia
NEXT_PUBLIC_CELO_AGENT_KEY="0x8bC6b190150796d92E7c32974338fB2F94033ed5"
NEXT_PUBLIC_ARB_AGENT_SESSION_KEYS="0xE2d82432C74Ac2E36327F3F5c02972Bb15a3c8bd"  # Arbitrum Sepolia (hardened: execute cap-bypass fix)

# --- Multi-EVM: deploy the market/P2P suite on any chain ---
# Pick the active venue the app reads (see packages/sdk/src/chain/registry.ts).
# Keys: celo-sepolia | celo | base-sepolia | base | arbitrum-sepolia | arbitrum
#       | optimism | optimism-sepolia | polygon | sepolia | ethereum
NEXT_PUBLIC_ACTIVE_CHAIN=celo-sepolia
# Add a chain by setting its prefixed addresses, e.g. for Base:
#   NEXT_PUBLIC_BASE_PREDICTION_MARKET, _REALIZED_ORACLE, _INTENT_MATCHER,
#   _AGENT_SESSION_KEYS, _AGENT_KEY, _TOKEN_{NGN,KES,GHS,USD}, _RPC_URL

# --- Solana venue (prediction markets + P2P on SVM) ---
# Set NEXT_PUBLIC_ACTIVE_CHAIN=solana (or solana-devnet) to make Solana the
# active home. Program id defaults to the Anchor workspace's declared id.
# NEXT_PUBLIC_SVM_CLUSTER=devnet          # devnet | testnet | mainnet-beta
# NEXT_PUBLIC_SVM_RPC_URL=                # custom RPC (else the cluster default)
# NEXT_PUBLIC_SVM_PREDICTION_MARKET=      # prediction_market program id
# NEXT_PUBLIC_SVM_REALIZED_ORACLE=        # realized_rate_oracle program id
# NEXT_PUBLIC_SVM_COLLATERAL_DECIMALS=6   # SPL mint decimals
# Gasless: a fee-payer relayer co-signs + submits SVM txs so users pay 0 SOL.
# NEXT_PUBLIC_SVM_FEE_PAYER=              # relayer public key (empty = user pays)
# SVM_FEE_PAYER_SECRET=                   # server-only: relayer secret (JSON array)

# --- LLM via OpenRouter (OpenAI-compatible) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=openai/gpt-4o-mini    # any OpenRouter model id
# OPENROUTER_APP_NAME=Pesarc

# --- Invest broker / market-data (stocks & ETFs) ---
# Empty = simulated broker (catalog prices, paper positions), fully demoable.
# Set to route quotes + orders to a real tokenized-equity / broker provider
# (see packages/sdk/src/broker.ts). No real order is placed until set.
NEXT_PUBLIC_BROKER_API_URL=
NEXT_PUBLIC_BROKER_API_KEY=

# Cash-out on-chain leg. "corridor" (default): on the hub chain, swap USD->cNGN
# on the pool and deposit cNGN into the escrow. "direct": send the USD stablecoin
# straight to the escrow (no pool) and let the fiat partner pay out — works on any
# chain (e.g. Arc mainnet before the hub is deployed). Off the hub chain the app
# uses direct automatically; set this to force it everywhere.
NEXT_PUBLIC_CASHOUT_MODE=
# Operator escrow/treasury wallet: the on-chain destination for cash-out inflow
# (the fiat partner pays the user from here). Set to a wallet you control on the
# live chain before going live. Defaults to the testnet operator.
NEXT_PUBLIC_RAMP_ESCROW=

# --- Fiat off-ramp partners (fiat last mile for bank / mobile-money payouts) ---
# Empty = simulated settlement (initiated → processing → paid on a timeline),
# fully demoable on testnet. Set a provider's keys to drive real payouts + status
# (see packages/sdk/src/ramp.ts). While testing, use each provider's TEST/sandbox
# secret key so no real funds move.
#
# Per-country partner order picks the rail per market (primary first), with an
# online/health probe choosing the first live partner. Override the global order
# with RAMP_PROVIDER_ORDER, and per country with RAMP_COUNTRY_PROVIDERS, e.g.
# "NG:bachs,paystack;KE:flutterwave;GH:flutterwave,paystack". RAMP_COUNTRY_PROVIDERS
# overrides the built-in per-country order in packages/sdk/src/ramp.ts. Default
# global order: cngn,bachs,paystack,flutterwave,http.
#
# A corridor (country/currency) only pays out for real once that provider's key is
# set AND its partner account is funded/enabled for that currency; otherwise
# selection falls through to the next partner and finally the simulator. With no
# keys set everything settles on the simulated timeline.
RAMP_PROVIDER_ORDER="cngn,bachs,paystack,flutterwave,http"
RAMP_COUNTRY_PROVIDERS=

# Bank-partner rail (primary for its markets, e.g. Nigeria). Keys are picked by
# environment: BACHS_ENV ("live"|"sandbox"; defaults from NODE_ENV) selects
# BACHS_PROD_KEY vs BACHS_TEST_KEY. BACHS_SECRET_KEY overrides both. The API base
# follows the key's own sk_live_/sk_sandbox_ prefix. Markets + currencies the
# partner serves (ISO codes) gate routing. Webhook (payout.*) is verified with the
# matching signing secret; point the partner's webhook at <origin>/api/payouts/webhook.
# The adapter supports both bank and mobile-money payouts, but a currency only
# actually pays out once the partner account has a SETTLEMENT WALLET for it. Adding
# a country/currency here that the account can't settle would fail the payout rather
# than fall back, so only list markets the account is enabled for (NG today).
BACHS_ENV=
BACHS_TEST_KEY=
BACHS_PROD_KEY=
BACHS_SECRET_KEY=
BACHS_TEST_WEBHOOK_SECRET=
BACHS_PROD_WEBHOOK_SECRET=
BACHS_WEBHOOK_SECRET=
BACHS_COUNTRIES=
BACHS_CURRENCIES=
BACHS_BASE_URL=

# Paystack (Nigeria-first NGN bank transfers). Also powers live bank list +
# NUBAN name resolution in the Send flow (banks.ts). Use sk_test_… while testing.
# Webhook (transfer.*) is verified with this same secret (x-paystack-signature),
# so point your Paystack dashboard webhook at <origin>/api/payouts/webhook.
PAYSTACK_SECRET_KEY=

# Flutterwave (the broad pan-African rail: bank + mobile money across NG/GH/KE/UG/
# TZ/ZA/MW/ZM/SL + XAF/XOF franco markets). Handles mobile-money payouts (M-Pesa,
# MTN, Airtel/Orange) where account_bank is the NETWORK code (e.g. MPS, MTN, FMM)
# and the account number is the recipient phone. Use your TEST secret while testing.
# A given currency only pays out once your Flutterwave balance is funded for it.
# The webhook is verified by a static hash you set in the Flutterwave dashboard and
# mirror here; point it at <origin>/api/payouts/webhook.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# cNGN (native NGN redemption → Nigerian bank; Nigeria/NGN only). Configured once
# all three secrets are set (otherwise the sim path is used). Testnet vs mainnet is
# selected by the API key prefix: cngn_test_… => sandbox, cngn_live_… => production.
# CNGN_BASE_URL overrides the API host (default https://api.cngn.co/v1/api) if the
# vendor changes it or to point at a sandbox host. Never commit real keys.
CNGN_API_KEY=
CNGN_ENCRYPTION_KEY=
CNGN_SSH_PRIVATE_KEY=
CNGN_BASE_URL=

# Generic HTTP ramp partner (fallback for a custom provider). Its webhook is
# verified with RAMP_WEBHOOK_SECRET (HMAC-SHA256, X-Ramp-Signature).
RAMP_PROVIDER_URL=
RAMP_API_KEY=
RAMP_WEBHOOK_SECRET=
