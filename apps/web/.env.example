# StableArc — environment template. Copy to .env and fill in.
# .env is git-ignored; never commit real secrets.

# Neon Postgres (waitlist + transfers). Empty = local .data/*.jsonl fallback.
DATABASE_URL=""

# Public site URL (SEO / canonical / sitemap)
NEXT_PUBLIC_SITE_URL="https://stablearc.app"

# ----- Testnet beta (B1/B2/B3) -----
# Privy app ID. Empty = mock mode (simulated demo). Set it to enable live
# testnet mode: passkey/phone sign-up + smart wallet on the hub chain.
NEXT_PUBLIC_PRIVY_APP_ID=""
# Alchemy Wallet APIs key + Gas Manager policy for gasless smart-wallet sends.
NEXT_PUBLIC_ALCHEMY_API_KEY=""
NEXT_PUBLIC_ALCHEMY_GAS_POLICY_ID=""
# Destination for testnet sends; empty = self-send.
NEXT_PUBLIC_TEST_RECIPIENT=""

# Hub chain: 421614 = Arbitrum Sepolia | 11155111 = Ethereum Sepolia (current deployment).
NEXT_PUBLIC_HUB_CHAIN_ID="11155111"
NEXT_PUBLIC_HUB_RPC_URL=""

# Arbitrum Sepolia contract addresses (after redeploying the hub there).
NEXT_PUBLIC_ARB_POOL_MANAGER=""
NEXT_PUBLIC_ARB_HOOK=""
NEXT_PUBLIC_ARB_SWAP_ROUTER=""
NEXT_PUBLIC_ARB_LIQUIDITY_ROUTER=""
NEXT_PUBLIC_ARB_SAFETY_MODULE=""
NEXT_PUBLIC_ARB_ORACLE_ADAPTER=""
NEXT_PUBLIC_ARB_STATE_VIEW=""
NEXT_PUBLIC_ARB_TOKEN_USD=""
NEXT_PUBLIC_ARB_TOKEN_NGN=""

NEXT_PUBLIC_ARB_QUOTER=
NEXT_PUBLIC_ARB_FX_AGGREGATOR=
NEXT_PUBLIC_ARB_SETTLEMENT_NETTING=
NEXT_PUBLIC_ARB_TOKEN_GHS=
NEXT_PUBLIC_ARB_INTENT_MATCHER=

# Server-only: netting-set operator key (testnet KYB auto-approve + settle CRON stand-in)
SETTLE_OPERATOR_PK=
NEXT_PUBLIC_ARB_BRIDGE_RECEIVER=
NEXT_PUBLIC_ARB_REALIZED_ORACLE=
NEXT_PUBLIC_ARB_TOKEN_KES=

# Auth for privileged API routes (settle/join/oracle/solver). Production MUST set this.
OPERATOR_API_SECRET=
# Vercel Cron secret — guards the scheduled solver run.
CRON_SECRET=

# Server-only: verifies Privy access tokens so DB rows scope to the real user.
# Without it every caller falls back to the shared demo account.
PRIVY_APP_SECRET=

# --- Celo "Agents at Work" submission ---
# Model-agnostic LLM for the settlement agent (OpenAI-compatible or Anthropic).
# Cencori (hackathon AI partner) is OpenAI-compatible — set its base URL here.
LLM_PROVIDER=            # openai | anthropic (default: auto-detect)
LLM_BASE_URL=            # e.g. https://api.cencori.com/v1  (OpenAI-compatible)
LLM_API_KEY=
LLM_MODEL=               # e.g. gpt-4o-mini, llama-3.3-70b, claude-sonnet-4-5
# Server-only: the settlement agent's key on Celo (submits intents + settles).
CELO_AGENT_PK=
NEXT_PUBLIC_CELO_RPC_URL=
NEXT_PUBLIC_CELO_INTENT_MATCHER=
NEXT_PUBLIC_CELO_REALIZED_ORACLE=
NEXT_PUBLIC_CELO_TOKEN_NGN=
NEXT_PUBLIC_CELO_TOKEN_GHS=
NEXT_PUBLIC_CELO_TOKEN_KES=
# ERC-8021 attribution tag from Celo Builders registration (celo_...). Required
# to be counted on the hackathon leaderboards — it goes in every tx's calldata.
NEXT_PUBLIC_CELO_ATTRIBUTION_TAG=
NEXT_PUBLIC_CELO_OWN_TAG=

# --- StableArc on Celo Sepolia (prediction & hedge market) ---
NEXT_PUBLIC_CELO_RPC_URL=
NEXT_PUBLIC_CELO_INTENT_MATCHER=
NEXT_PUBLIC_CELO_REALIZED_ORACLE=
NEXT_PUBLIC_CELO_PREDICTION_MARKET=
NEXT_PUBLIC_CELO_TOKEN_NGN=
NEXT_PUBLIC_CELO_TOKEN_GHS=
NEXT_PUBLIC_CELO_TOKEN_KES=
NEXT_PUBLIC_CELO_TOKEN_USD=
