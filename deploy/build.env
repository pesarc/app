# Public build-time config for the web client (NEXT_PUBLIC_*). These values are
# inlined into the client bundle and therefore ship to every browser — they are
# NOT secret (contract addresses, URLs, chain IDs), so they live here under
# version control instead of in a hand-edited BUILD_DOTENV secret.
#
# The build workflow (.github/workflows/build-image.yml) uses this file and
# APPENDS the few abuse-sensitive values from GitHub Actions secrets:
#   NEXT_PUBLIC_PRIVY_APP_ID, NEXT_PUBLIC_ALCHEMY_API_KEY,
#   NEXT_PUBLIC_ALCHEMY_GAS_POLICY_ID
#
# To change public config: edit this file, commit, and the next build picks it
# up (no more dropping a line from a giant secret). To change a secret: update
# the GitHub Actions secret. Server-only secrets (SETTLE_OPERATOR_PK,
# OPERATOR_API_SECRET, DATABASE_URL, BACHS_*, NGN_PARALLEL_PREMIUM, …) are NOT
# build-time — they live in /etc/pesarc/pesarc.env on the host.

# --- URLs ---
NEXT_PUBLIC_SITE_URL=https://pesarc.xyz
NEXT_PUBLIC_APP_URL=https://app.pesarc.xyz

# --- Default network: Arc (where user funds are) ---
NEXT_PUBLIC_ACTIVE_CHAIN=arc
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io

# --- Hub = Arbitrum Sepolia (DO NOT set 11155111 — that is Eth Sepolia) ---
NEXT_PUBLIC_HUB_CHAIN_ID=421614

# --- Hub pool + NGN oracle (deployed Arbitrum Sepolia addresses) ---
NEXT_PUBLIC_ARB_POOL_MANAGER=0x48484e904EA964a649D0c73666bA1E91d3Ca2349
NEXT_PUBLIC_ARB_HOOK=0x0816F36c4C0cc61Ae80aD5e1De0720104d93C5C4
NEXT_PUBLIC_ARB_SWAP_ROUTER=0x15F12CC147484F7640dE6296c9D302802726A8dB
NEXT_PUBLIC_ARB_LIQUIDITY_ROUTER=0x416a7Cb5B9F29DCA866a113C1aD5318d2c0b1aE0
NEXT_PUBLIC_ARB_SAFETY_MODULE=0x5280987cAEbaADa7dE8D11a2CDDeC97157feDf10
NEXT_PUBLIC_ARB_ORACLE_ADAPTER=0x6616D69AcbB9fe9Ef630171C069CC069a0d8464f
NEXT_PUBLIC_ARB_STATE_VIEW=0x5f7Cb34cA29d0554998882B716DC86e0B764f206
NEXT_PUBLIC_ARB_TOKEN_USD=0x55C45Cb7C3b92a80bb548497f6Cd91aB45730621
