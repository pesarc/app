# Podman Quadlet unit — Pesarc web app, dev stack.
# Install to /etc/containers/systemd/pesarc-web-dev.container on the droplet:
#   sudo systemctl daemon-reload && sudo systemctl start pesarc-web-dev
#
# Reads its runtime env from /etc/pesarc/dev/pesarc.env (root-only, chmod 600).
# That file MUST set APP_ENV=dev, NEXT_PUBLIC_APP_ENV=dev, and a DATABASE_URL
# that points at THIS env's own Postgres instance:
#   postgres://pesarc:<pw>@pesarc-db-dev:5432/pesarc
# Caddy proxies dev's subdomain to 127.0.0.1:3002 (see deploy/ENVIRONMENTS.md).

[Unit]
Description=Pesarc web app (dev)
After=network-online.target pesarc-db-dev.service
Wants=network-online.target

[Container]
Image=ghcr.io/pesarc/pesarc-web:dev
ContainerName=pesarc-web-dev
Network=pesarc.network
PodmanArgs=--network-alias pesarc-web-dev
EnvironmentFile=/etc/pesarc/dev/pesarc.env
PublishPort=127.0.0.1:3002:3000
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target default.target
